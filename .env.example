# Copy to .env.local and fill in. Never commit .env.local.

# Contact form (Resend). Without these, dev logs submissions to the console.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Helping Hands <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Admin login
ADMIN_PASSWORD=
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Free stock photos on the Pricing page. Get a key at https://www.pexels.com/api/
# Without it, the page uses the local photos in public/images.
PEXELS_API_KEY=
